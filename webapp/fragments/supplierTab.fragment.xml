  
 <core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:f="sap.ui.layout.form">
  <Table id="idTable" mode="SingleSelectLeft" items="{/suppliers}" >  

    <headerToolbar>
        <Toolbar>
            
            <ToolbarSpacer/>
            <Button icon="sap-icon://filter" tooltip="Filter Data" press="onFilter"/>
        </Toolbar>
        </headerToolbar>



    <columns>
        <Column>
           <header>
                 <Label text="Name"></Label>
          </header>
        </Column>
         <Column>
           <header>
                 <Label text="City"></Label>
          </header>
        </Column> 
         <Column>
           <header>
                 <Label text="since When"></Label>
          </header>
        </Column> <Column>
           <header>
                 <Label text="contact Person"></Label>
          </header>
        </Column>
    </columns>
    <items>
        <ColumnListItem >
            <cells>
                <Text text="{name}"></Text>
                <Input value="{city}" showValueHelp="true" valueHelpRequest="onF4Help"/>
                <Text text="{sinceWhen}"></Text>
                <VBox>
                <Text text="{contactPerson}"></Text>
                 <Text text="{contactNo}"></Text></VBox>
               
            </cells>
        </ColumnListItem>
    </items>
    </Table>  
        </core:FragmentDefinition>