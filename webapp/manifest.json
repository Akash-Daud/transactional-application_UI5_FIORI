{
    "version": "1.43.0",
    "sap.app": {

        "id": "com.gbis.fiori.app",
        "type": "application",
        "ach":"FioriLike",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "i18n": "i18n/i18n.properties"
    },

    "sap.ui":{
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        },
        "supportedThemes": [
            "sap_belize",
            "sap_belize_plus",
            "sap_fiori_3",
            "sap_fiori_3_dark"
        ],
        "fullWidth": true,
        "technology": "UI5"

    },

    "sap.ui5":{

        "dependencies": {
            "minUI5Version": "1.43.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.ui.layout": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "": {
                "type": "sap.ui.model.json.JSONModel",
                "uri": "mockdata/fruits.json",
                "preload": true,
                "settings": {}
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "preload": true, 
                "settings": {
                    "bundleName": "com.gbis.fiori.app.i18n.i18n"
                }
            }
               
            }
        }

    }
